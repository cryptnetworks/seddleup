{
  "name": "triptally",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "markdownlint-cli2",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:check": "npm run docs:lint && npm run docs:links",
    "workflows:check": "node scripts/check-workflow-policy.mjs",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run tests/unit && vitest run tests/integration --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "node scripts/run-development-e2e.mjs",
    "test:e2e:ci": "node scripts/run-development-e2e.mjs tests/e2e/smoke.spec.ts tests/e2e/auth.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/receipts.spec.ts tests/e2e/mobile-ios.spec.ts --project=Chromium --project='Mobile Safari'",
    "test:e2e:production": "node scripts/run-production-e2e.mjs",
    "test:e2e:receipts": "node scripts/run-receipt-e2e.mjs",
    "test:e2e:ui": "node scripts/run-development-e2e.mjs --ui",
    "test:e2e:headed": "node scripts/run-development-e2e.mjs --headed",
    "test:e2e:ios": "node scripts/run-development-e2e.mjs --project='Mobile Safari'",
    "test:docker": "bash scripts/probe-docker-runtime.sh seddleup:ci",
    "test:docker:profiles": "bash scripts/probe-docker-profiles.sh seddleup:ci",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "security:audit": "npm audit --audit-level=high",
    "security:scan": "npm run security:audit",
    "validate:config": "node scripts/validate-config.mjs",
    "discord:register": "node scripts/register-discord-commands.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "emailjs": "^5.0.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "markdownlint-cli2": "^0.23.0",
    "picomatch": "^4.0.5",
    "postcss": "8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.16",
    "@hono/node-server": "1.19.13"
  }
}
